# Ventra Insurance Group — environment variables
# Copy to .env.local and fill in. All values are [CONFIRM] pending manager input.

# --- Contact details (shown in footer / contact page) ---
# [CONFIRM] CallRail tracking number, e.g. (305) 555-0100
NEXT_PUBLIC_CONTACT_PHONE=
# [CONFIRM] routing / inbox email
NEXT_PUBLIC_CONTACT_EMAIL=
# [CONFIRM] business mailing address
NEXT_PUBLIC_CONTACT_ADDRESS=

# --- Contact form submission (phase 7) ---
# Every submission is emailed to the team inbox via Resend (resend.com).
# 1) Create a Resend account and API key.
# 2) Verify the ventrainsurance.com domain in Resend (add the DNS records it gives you).
# 3) Set the vars below (in .env.local for dev, and in Vercel → Settings → Environment Variables for prod).
RESEND_API_KEY=
# Inbox that receives the leads.
CONTACT_TO_EMAIL=info@ventrainsurance.com
# Sender for the internal lead notification. Resend's shared onboarding@resend.dev
# works without verifying a domain (customer never sees it; Reply-To = the lead).
# NOTE: while unverified, Resend only delivers to the Resend account's own email.
CONTACT_FROM_EMAIL=Ventra Website Leads <onboarding@resend.dev>
# [OPTIONAL] GoHighLevel / CRM webhook — payload is also forwarded here if set (best-effort).
CONTACT_FORM_ENDPOINT=

# --- Analytics / tracking (phase 8) — do NOT hardcode IDs in code ---
# [CONFIRM] which CallRail script / Google Ads / Meta pixel are in use
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CALLRAIL_ID=
